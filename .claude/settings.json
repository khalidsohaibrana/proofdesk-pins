{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(printenv*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin --delete main*)",
      "Bash(git push origin :main*)",
      "Bash(git reset --hard origin*)",
      "Bash(git branch -D main*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api -X PUT repos/*/branches/*/protection*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf .git*)",
      "Bash(dropdb*)",
      "Bash(npx drizzle-kit drop*)",
      "Bash(drizzle-kit drop*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(npx vercel --prod*)",
      "Bash(fly deploy*)",
      "Bash(flyctl deploy*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-system/hooks/guard-main-checkout.mjs\""
          }
        ]
      },
      {
        "matcher": "Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-system/hooks/cap-subagents.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
